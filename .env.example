# ============================================================
# DJELI'S PROMO AI — Variables d'environnement
# Copier en .env.local (dev) et dans Vercel (prod).
#
# Toutes les valeurs ci-dessous sont des PLACEHOLDERS volontairement invalides :
# copiées telles quelles, elles font échouer le démarrage / renvoyer 503.
# Chaque secret doit être remplacé par une vraie valeur.
# ============================================================

# --- Authentification admin (MVP : mot de passe unique) ---
# 16 caractères minimum, unique. (rejeté s'il contient "changez")
ADMIN_PASSWORD=changez-moi

# 32 caractères minimum, aléatoire : `openssl rand -hex 32`
# (rejeté s'il contient "chaine-aleatoire" ou < 32 caractères)
SESSION_SECRET=chaine-aleatoire-a-remplacer

# --- URL publique de l'application (vérification d'origine des requêtes) ---
# En production : obligatoire (ex : https://promo.mondomaine.fr).
APP_URL=http://localhost:3000

# --- Supabase : accès de l'APPLICATION (Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=   # clé service_role — JAMAIS côté navigateur

# --- Supabase : accès SQL direct (Settings > Database) ---
# Utilisés UNIQUEMENT par les scripts (migrate.mjs, backup.sh), jamais par le runtime.
# DIRECT_URL = pooler mode SESSION (port 5432) : migrations + pg_dump.
# DATABASE_URL = pooler mode TRANSACTION (port 6543, pgbouncer=true) : non requis ici.
DIRECT_URL=postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- IA (Claude par défaut ; vide = fallback gabarits/mots-clés) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# --- WhatsApp Cloud API (niveau app Meta ; tokens/numéros PAR CLIENT en base) ---
# Jeton de vérification du webhook, 16 caractères minimum (ici trop court → 503).
WHATSAPP_VERIFY_TOKEN=CHANGEZ
# App secret Meta, 32 caractères minimum (ici trop court → 503).
WHATSAPP_APP_SECRET=CHANGEZ
# Optionnel : version Graph API (défaut v21.0).
# WHATSAPP_GRAPH_VERSION=v21.0

# --- Cron (protège /api/cron/scheduler) ---
# 32 caractères minimum (ici trop court → 503).
CRON_SECRET=CHANGEZ

# --- Mode démo global (true = aucun envoi réel, même si credentials présents) ---
DEMO_MODE=true
